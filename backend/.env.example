# Local development values only. Copy this file to .env before starting Compose.
API_PORT=8080
POSTGRES_DB=llm_homework
POSTGRES_USER=app
POSTGRES_PASSWORD=local-dev-password
DATABASE_URL=postgres://app:local-dev-password@postgres:5432/llm_homework?sslmode=disable
# Comma-separated origins allowed to call the API with credentials (CORS).
# Defaults to Vite (5173) and CRA/Next (3000) dev servers if left unset.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
# Photo-recognition provider. Leave unset in production (no real OCR/LLM
# provider is wired in yet, so the endpoint reports unavailable). Set to
# "mock" for local dev/testing to get a canned draft back instead.
# RECOGNITION_PROVIDER=mock
